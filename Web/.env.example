# Copiá este archivo a ".env" (en esta misma carpeta) y completá tus valores reales.
# El archivo ".env" nunca se sube a git (ver .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bd_ERPInmobiliaria
DB_USER=tu_usuario_de_postgres
DB_PASSWORD=tu_contraseña_de_postgres

# Clave secreta usada para firmar la cookie de sesión.
# Generá una propia con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# "desarrollo" (por defecto) o "produccion".
# En "produccion" la cookie de sesión solo viaja por HTTPS.
ENTORNO=desarrollo

# --- Pagos online (Mercado Pago) ---
# Credenciales de tu cuenta de Mercado Pago Developers:
#   https://www.mercadopago.com.ar/developers/panel/app
# Para probar primero usá las credenciales de PRUEBA (empiezan con TEST-).
MP_ACCESS_TOKEN=TEST-tu-access-token-de-mercado-pago
MP_PUBLIC_KEY=TEST-tu-public-key-de-mercado-pago

# URL pública por la que se puede llegar a este sitio desde internet.
# Mercado Pago la necesita para mandar la confirmación del pago (webhook)
# y para volver acá después del checkout. "localhost" NO sirve para esto:
# en desarrollo usá una URL de ngrok (ver instrucciones), y en producción
# la URL real de tu dominio.
APP_BASE_URL=http://localhost:8000
